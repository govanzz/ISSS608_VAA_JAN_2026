            <column caption='Pearson Correlation Coefficient' datatype='real' name='[Calculation_0376071633035264]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CORR(&#13;&#10;    {INCLUDE [Order ID]: SUM([Sales])},&#13;&#10;    {INCLUDE [Order ID (Orders1)]: SUM([Sales (Orders1)])}&#13;&#10;)' />
            </column>
            <column caption='Boolean' datatype='boolean' name='[Calculation_0376071636553729]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Sub-Category] = [Sub-Category (Orders1)]' />
